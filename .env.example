# --- Required ---
# Any long random string; used to derive the AES-256 key that encrypts stored passwords.
# Generate: openssl rand -base64 32     (changing it later makes stored secrets undecryptable)
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Database (docker-compose / Render set these for you) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobportal
DB_USERNAME=jobportal
DB_PASSWORD=jobportal

# --- Server / storage ---
PORT=8080
APP_DATA_DIR=./data

# --- Scheduler (Spring 6-field cron) ---
SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 0 */2 * * *
SCHEDULER_ZONE=UTC
SCHEDULER_DELAY_MS=1500
HTTP_RETRIES=3

# --- Cleanup scheduler (deletes jobs older than 10 days) ---
CLEANUP_ENABLED=true
CLEANUP_CRON=0 0 0 * * SUN
CLEANUP_ZONE=Asia/Kolkata

# --- Email notifications ---
EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# Candidate profile (name, skills, location, CTC, notice period, resume URL, default portal
# credentials) is set after startup via PUT /api/profile (Swagger UI) and stored in the DB.
